generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  WAREHOUSE_MANAGER
  SITE_MANAGER
  EMPLOYEE
}

enum ItemCategory {
  SETUP
  UNIFORM
  GLASSWARE
  DISPOSALS
  CONSUMABLE
}

enum ItemUnit {
  PCS
  BOX
}

enum EventStatus {
  UPCOMING
  ONGOING
  COMPLETED
  CANCELLED
}

model User {
  id         String @id @default(cuid())
  email      String @unique
  name       String
  role       Role   @default(EMPLOYEE)
  employeeId String? @unique
}

model Item {
  id             String               @id @default(cuid())
  sku            String               @unique
  itemName       String
  category       ItemCategory
  subCategory    String?
  brand          String?
  vendor         String?
  unit           ItemUnit
  openingStock   Int
  currentStock   Int
  availableStock Int
  status         String
  expiryDate     DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  inventory      EventInventory[]
  returns        EventReturnSummary[]
}

model Event {
  id             String               @id @default(cuid())
  eventName      String
  eventCode      String               @unique
  eventDate      DateTime
  startTime      String
  endTime        String?
  venue          String
  pax            Int
  eventType      String
  company        String
  crm            String
  siteManager    String
  siteSupervisor String
  butlerVendor   String?
  bartenders     Int
  maleButler     Int
  femaleButler   Int
  clientName     String
  clientPhone    String
  clientEmail    String
  status         EventStatus          @default(UPCOMING)
  inventoryCost  Float
  staffCost      Float
  totalCost      Float
  inventory      EventInventory[]
  returns        EventReturnSummary[]
}

model EventInventory {
  id                String @id @default(cuid())
  eventId           String
  itemId            String
  requiredQuantity  Int
  availableQuantity Int
  reserveQuantity   Int
  issueQuantity     Int
  remarks           String
  event             Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  item              Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)
}

model EventReturnSummary {
  id               String @id @default(cuid())
  eventId          String
  itemId           String
  issuedQuantity   Int
  returnedQuantity Int
  damagedQuantity  Int
  lostQuantity     Int
  consumedQuantity Int
  remarks          String
  event            Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  item             Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)
}

model Complain {
  id              String   @id @default(cuid())
  complainId      String   @unique
  siteManagerName String
  eventId         String?
  description     String
  status          String
  createdAt       DateTime @default(now())
}
