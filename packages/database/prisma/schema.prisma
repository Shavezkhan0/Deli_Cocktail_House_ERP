generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
}

enum EmployeeDesignation {
  MANAGER
  SUPERVISOR
  STAFF
  BARTENDER
  BUTLER
  CRM
  ORDERING_OPERATOR
  DESIGNER
  GRAPHIC_DESIGNER
  DATA_ENTRY_OPERATOR
  MIS
  WAREHOUSE_MANAGER
  INVENTORY_MANAGER
  PERMANENT_LABOUR
  SOFTWARE_DEVELOPER
  OFFICE_BOY
  DRIVER
  SECURITY_GUARD
  SALES_EXECUTIVE
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  SHORT_LEAVE
  ON_LEAVE
}

enum EmployeeStatus {
  ACTIVE
  LEFT
}

enum ItemCategory {
  SETUP
  UNIFORM
  GLASSWARE
  DISPOSALS
  CONSUMABLE
}

enum ItemUnit {
  PCS
  BOX
}

enum EventStatus {
  UPCOMING
  ONGOING
  COMPLETED
  CANCELLED
}

model Admin {
  id    String @id @default(cuid())
  email String @unique
  name  String
  role  Role   @default(ADMIN)

  @@map("Admin")
}

model Employee {
  id               String              @id @default(cuid())
  employeeId       String              @unique
  email            String?             @unique
  name             String
  contact          String?
  emergencyContact String?
  designation      EmployeeDesignation @default(STAFF)
  baseSalary       Float               @default(0)
  joiningDate      DateTime            @default(now())
  status           EmployeeStatus      @default(ACTIVE)
  leavingDate      DateTime?

  // Document fields (Optional)
  aadharUrl      String?
  panCardUrl     String?
  offerLetterUrl String?
  bondUrl        String?

  // Bank fields (Optional)
  bankAccountNo    String?
  bankBranch       String?
  bankIfsc         String?
  bankOtherDetails String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  salaries       Salary[]
  attendances    Attendance[]
  weeklyScores   WeeklyScore[]
  tasks          Task[]
  vendorContacts VendorContact[]
  expenseEntries ExpenseEntry[]
  travelDetails  TravelDetail[]
  sales          Sale[]
  crmEvents          Event[]  @relation("EventCrm")
  siteManagerEvents  Event[]  @relation("EventSiteManager")
  siteSupervisorEvents Event[] @relation("EventSiteSupervisor")
}

model Attendance {
  id         String           @id @default(cuid())
  employeeId String
  date       DateTime
  status     AttendanceStatus
  latitude   Float?
  longitude  Float?
  employee   Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@unique([employeeId, date])
}

model Item {
  id             String               @id @default(cuid())
  sku            String               @unique
  itemName       String
  category       ItemCategory
  subCategory    String?
  brand          String?
  vendor         String?
  unit           ItemUnit
  openingStock   Int
  currentStock   Int
  availableStock Int
  status         String
  expiryDate     DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  inventory      EventInventory[]
  returns        EventReturnSummary[]
}

model Event {
  id             String               @id @default(cuid())
  eventName      String
  eventCode      String               @unique
  eventDate      DateTime
  startTime      String?
  endTime        String?
  venue          String
  pax            Int
  eventType      String
  company        String
  crm            String?
  siteManager    String?
  siteSupervisor String?
  butlerVendor   String?
  bartenders     Int
  maleButler     Int
  femaleButler   Int
  clientName     String
  clientPhone    String
  clientEmail    String?
  status         EventStatus          @default(UPCOMING)
  inventoryCost  Float
  staffCost      Float
  totalCost      Float

  crmEmployeeId    String?
  siteManagerId    String?
  siteSupervisorId String?

  crmEmployee       Employee? @relation("EventCrm", fields: [crmEmployeeId], references: [id])
  siteManagerEmp    Employee? @relation("EventSiteManager", fields: [siteManagerId], references: [id])
  siteSupervisorEmp Employee? @relation("EventSiteSupervisor", fields: [siteSupervisorId], references: [id])

  inventory      EventInventory[]
  returns        EventReturnSummary[]
  crmChecklist   EventCrmChecklistItem[]
}

model EventCrmChecklistItem {
  id        String   @id @default(cuid())
  eventId   String
  section   String   @default("General")
  label     String
  completed Boolean  @default(false)
  sortOrder Int      @default(0)
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventId])
}

model EventInventory {
  id                String @id @default(cuid())
  eventId           String
  itemId            String
  requiredQuantity  Int
  availableQuantity Int
  reserveQuantity   Int
  issueQuantity     Int
  remarks           String
  event             Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  item              Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)
}

model EventReturnSummary {
  id               String @id @default(cuid())
  eventId          String
  itemId           String
  issuedQuantity   Int
  returnedQuantity Int
  damagedQuantity  Int
  lostQuantity     Int
  consumedQuantity Int
  remarks          String
  event            Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  item             Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)
}

model Complain {
  id              String   @id @default(cuid())
  complainId      String   @unique
  siteManagerName String
  eventId         String?
  description     String
  status          String
  createdAt       DateTime @default(now())
}

model Salary {
  id         String    @id @default(cuid())
  employeeId String
  month      Int // 1-12
  year       Int // e.g., 2024
  amount     Float
  status     String    @default("UNPAID") // PAID or UNPAID
  paidDate   DateTime?
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([employeeId, month, year])
}

model AppSettings {
  id        String   @id @default(cuid())
  key       String   @unique // e.g. "OFFICE_LAT", "OFFICE_LNG", "ATTENDANCE_RADIUS_M"
  value     String
  updatedAt DateTime @updatedAt
}

model WeeklyScore {
  id         String   @id @default(cuid())
  employeeId String
  weekStart  DateTime // Monday of the week
  score      Int // 0-10, entered by admin
  notes      String?
  createdAt  DateTime @default(now())
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, weekStart])
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  DONE
}

model Task {
  id          String     @id @default(cuid())
  assignedTo  String // employeeId
  assignedBy  String? // admin name/id
  title       String
  description String?
  dueDate     DateTime?
  status      TaskStatus @default(PENDING)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  employee    Employee   @relation(fields: [assignedTo], references: [id], onDelete: Cascade)
}

model VendorContact {
  id        String   @id @default(cuid())
  addedBy   String // employeeId
  name      String
  phone     String
  category  String
  eventId   String?
  notes     String?
  createdAt DateTime @default(now())
  employee  Employee @relation(fields: [addedBy], references: [id], onDelete: Cascade)
}

model ExpenseEntry {
  id          String   @id @default(cuid())
  submittedBy String // employeeId
  eventId     String?
  amount      Float
  description String
  receiptUrl  String?
  status      String   @default("PENDING") // PENDING | APPROVED | REJECTED
  createdAt   DateTime @default(now())
  employee    Employee @relation(fields: [submittedBy], references: [id], onDelete: Cascade)
}

model TravelDetail {
  id         String   @id @default(cuid())
  employeeId String
  eventId    String?
  from       String
  to         String
  travelDate DateTime
  mode       String // Car, Train, Flight, etc.
  amount     Float?
  createdAt  DateTime @default(now())
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model Sale {
  id            String   @id @default(cuid())
  employeeId    String
  eventId       String?
  itemName      String
  quantity      Int      @default(1)
  unitPrice     Float
  amount        Float
  customerName  String?
  customerPhone String?
  notes         String?
  createdAt     DateTime @default(now())
  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model PdfCompanySettings {
  id               String  @id @default(cuid())
  companyName      String
  logoUrl          String?
  headerLogoUrl    String?
  address          String?
  phone1           String?
  phone2           String?
  email            String?
  footerText       String?
  defaultFont      String  @default("Helvetica")
  defaultTheme     String  @default("modern")
  defaultTerms     String?
  defaultDeliverables Json?
  defaultMixers    Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model PdfEvent {
  id                String   @id @default(cuid())
  eventId           String   @unique
  eventName         String
  startDate         DateTime
  endDate           DateTime
  venue             String
  city              String?
  state             String?
  eventType         String?
  packageType       String?
  packagePax        Int?
  clientName        String?
  clientContact     String?
  specialInstructions String?
  pdfTitle          String?
  status            String   @default("DRAFT")
  deliverables      Json?
  mixers            Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  functions         PdfFunction[]
}

model PdfFunction {
  id                 String     @id @default(cuid())
  eventId            String
  functionName       String
  date               DateTime
  startTime          String?
  endTime            String?
  pax                Int?
  bartenders         Int?
  butlers            Int?
  siteManager        String?
  theme              String?
  description        String?
  notes              String?
  templateData       Json?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  event              PdfEvent   @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}
